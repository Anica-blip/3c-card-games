# wrangler.toml — 3C Card Games Worker
# 3C Thread To Success™
#
# This Worker is deployed with Wrangler (`npx wrangler deploy`) from a deploy
# folder that holds worker.js and this file side by side. Never paste the code
# into the Cloudflare dashboard: the next Wrangler deploy would overwrite it.
# Never run Wrangler from the repo root: the root wrangler.jsonc there is a
# leftover that would publish the whole repo as files and drop the R2 binding.

name = "3c-card-games"
main = "worker.js"
compatibility_date = "2024-01-01"

# The free Cloudflare address is how the admin pages and the public deck pages
# reach this Worker (WORKER_URL), so it stays on. The preview address is not
# used by anything and is switched off.
workers_dev = true
preview_urls = false

# R2 bucket binding
# bucket_name must match the exact name in your Cloudflare R2 dashboard
[[r2_buckets]]
binding = "CARD_GAMES_BUCKET"
bucket_name = "3c-library-files"

# No [vars] and no secrets: the owner check uses Supabase's public address and
# public anon key, which live in worker.js. Sign-in itself happens in the admin
# pages (GitHub through Supabase), not in this Worker.
